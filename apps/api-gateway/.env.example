# Variaveis do API Gateway.
# No Docker Compose estes valores vem do .env da raiz; este arquivo serve para
# execucao local direta (npm run dev -w @loja-veloz/api-gateway).

NODE_ENV=development
ENVIRONMENT=development
SERVICE_NAME=api-gateway
SERVICE_VERSION=1.0.0
PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000

# Servicos internos (fora do Compose, use localhost)
ORDER_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
UPSTREAM_TIMEOUT_MS=5000

# Seguranca
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
BODY_LIMIT=100kb

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true
OTEL_SAMPLING_RATIO=1.0
