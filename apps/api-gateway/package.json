{
  "name": "@loja-veloz/api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Porta de entrada externa da plataforma Pedidos Veloz",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
