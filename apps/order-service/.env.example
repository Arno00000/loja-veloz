# Variaveis do Servico de Pedidos.
# No Docker Compose os valores vem do .env da raiz.

NODE_ENV=development
ENVIRONMENT=development
SERVICE_NAME=order-service
SERVICE_VERSION=1.0.0
PORT=3001
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=20000
BODY_LIMIT=100kb

# Banco exclusivo deste servico. O usuario orders_user tem permissao apenas
# em orders_db; ver database/postgres-init/01-create-databases.sh.
DATABASE_URL=postgresql://orders_user:orders_dev_only@localhost:5432/orders_db?schema=public

# Mensageria
RABBITMQ_URL=amqp://lojaveloz:lojaveloz_dev_only@localhost:5672
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_RECONNECT_MIN_MS=1000
RABBITMQ_RECONNECT_MAX_MS=30000

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true
OTEL_SAMPLING_RATIO=1.0
