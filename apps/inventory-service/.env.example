NODE_ENV=development
ENVIRONMENT=development
SERVICE_NAME=inventory-service
SERVICE_VERSION=1.0.0
PORT=3002
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=20000
BODY_LIMIT=100kb

DATABASE_URL=postgresql://inventory_user:inventory_dev_only@localhost:5432/inventory_db?schema=public

RABBITMQ_URL=amqp://lojaveloz:lojaveloz_dev_only@localhost:5672
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_RECONNECT_MIN_MS=1000
RABBITMQ_RECONNECT_MAX_MS=30000

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true
OTEL_SAMPLING_RATIO=1.0

# Endpoint academico. Desabilite em producao (INVENTORY_RESTOCK_ENABLED=false).
INVENTORY_RESTOCK_ENABLED=true
INVENTORY_ADMIN_KEY=admin_dev_only
