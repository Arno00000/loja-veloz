# =============================================================================
# Pedidos Veloz - variaveis de ambiente do ambiente local (Docker Compose)
# =============================================================================
# Copie para .env antes de subir a stack:
#   Bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
#
# Nenhum valor aqui e um segredo real. Sao credenciais de desenvolvimento
# descartaveis, usadas apenas dentro da rede do Docker Compose.
# Em Kubernetes estes valores vem de Secret; ver kubernetes/base/secret.example.yaml.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
ENVIRONMENT=development

# --- PostgreSQL (instancia unica, tres bancos logicamente separados) ---------
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=postgres_dev_only
POSTGRES_DB=postgres
POSTGRES_PORT=5432

ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=orders_dev_only

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_dev_only

PAYMENTS_DB_NAME=payments_db
PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=payments_dev_only

# URLs de conexao usadas pelos servicos dentro da rede do Compose.
# O host "postgres" e o nome do servico no docker-compose.yml.
ORDERS_DATABASE_URL=postgresql://orders_user:orders_dev_only@postgres:5432/orders_db?schema=public&connection_limit=10&pool_timeout=10
INVENTORY_DATABASE_URL=postgresql://inventory_user:inventory_dev_only@postgres:5432/inventory_db?schema=public&connection_limit=10&pool_timeout=10
PAYMENTS_DATABASE_URL=postgresql://payments_user:payments_dev_only@postgres:5432/payments_db?schema=public&connection_limit=10&pool_timeout=10

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_DEFAULT_USER=lojaveloz
RABBITMQ_DEFAULT_PASS=lojaveloz_dev_only
RABBITMQ_URL=amqp://lojaveloz:lojaveloz_dev_only@rabbitmq:5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=5000

# --- Portas expostas no host -------------------------------------------------
API_GATEWAY_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4317

# --- Comunicacao interna entre servicos (nomes de servico do Compose) --------
ORDER_SERVICE_URL=http://order-service:3001
INVENTORY_SERVICE_URL=http://inventory-service:3002
PAYMENT_SERVICE_URL=http://payment-service:3003
UPSTREAM_TIMEOUT_MS=5000

# --- Observabilidade ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_ENABLED=true
OTEL_SAMPLING_RATIO=1.0

# --- Seguranca do Gateway ----------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
BODY_LIMIT=100kb

# --- Recursos academicos de demonstracao -------------------------------------
# Quando true, pedidos do cliente PAYMENT_FAIL_CUSTOMER_ID sao sempre recusados
# pelo simulador de pagamentos. Recurso deterministico de demonstracao.
# Deve ser false em qualquer ambiente que pretenda representar producao.
PAYMENT_SIMULATION_ENABLED=true
PAYMENT_FAIL_CUSTOMER_ID=CUSTOMER-PAYMENT-FAIL
PAYMENT_PROCESSING_DELAY_MS=200

# Endpoint academico POST /inventory/restock. Exige o header x-admin-key.
# Deve ser desabilitado (false) em producao.
INVENTORY_RESTOCK_ENABLED=true
INVENTORY_ADMIN_KEY=admin_dev_only

# --- Imagens de contêiner ----------------------------------------------------
# Substitua <USUARIO_GITHUB> pelo dono do repositorio no GitHub.
IMAGE_REGISTRY=ghcr.io/<USUARIO_GITHUB>
IMAGE_TAG=local
